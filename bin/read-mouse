#!/bin/sh
# Reads Logitech devices with `solaar show` into a shared file that every bar
# watches, for a mouse UPower doesn't report: typically one on its cable,
# charging, which the kernel then treats as a plain wired mouse. Does nothing
# when Solaar isn't installed.
#
#   read-mouse [max-age]   skip the read when the file is newer than max-age
#                          seconds (default 0: always read)
#
# Same pattern as read-headset: reads take turns through a lock, a bar reuses
# a reading another bar just made, and the read runs in the background so the
# shell killing this script doesn't cut it off.

dir="${XDG_RUNTIME_DIR:-/tmp}/omabateq"
out="$dir/solaar.txt"
lock="$dir/solaar.lock"

if [ "$1" = "--locked" ]; then
  max_age="$2"
  if [ -e "$out" ]; then
    age=$(( $(date +%s) - $(stat -c %Y "$out") ))
    [ "$age" -lt "$max_age" ] && exit 0
  fi
  command -v solaar >/dev/null || exit 0
  text=$(timeout 15 solaar show 2>/dev/null)
  # One write, so a watching bar never sees a half-written file.
  printf '%s\n' "$text" > "$out"
  exit 0
fi

mkdir -p "$dir"
flock -w 20 "$lock" sh "$0" --locked "${1:-0}" &
wait
